# ============================================================
# Retail Audit AI Agent 环境变量示例
# 复制为 .env.local（本地开发）或通过部署平台注入环境变量。
# ⚠️ 请勿将填入真实密钥后的文件提交到版本库。
# ============================================================

# ---- 基础 ----
APP_NAME="Retail Audit AI Agent"
APP_URL="http://localhost:3000"

# ---- 会话安全 ----
# 必填。至少 16 个字符的强随机密钥。生成方式（Linux/macOS）：
#   openssl rand -base64 48
# 生产环境未配置时应用会拒绝启动。
JWT_SECRET=""

# 是否允许任何人公开注册（默认关闭，仅首个账号前可自助注册）
ALLOW_PUBLIC_REGISTRATION="false"

# ---- AI（OpenAI 兼容端点）----
# 默认指向阿里云百炼（DashScope）OpenAI 兼容模式，也可替换为
# 其他任意 OpenAI 兼容服务（自建网关、DeepSeek、本地 vLLM/Ollama 等）。
# 注意：请填入"完整 chat/completions 地址"或"接口根地址"均可，代码会自动补全路径。
QWEN_API_URL="https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions"
# 必填，用于 AI 风险解释与项目问答。未配置时相关功能回退到本地规则应答。
QWEN_API_KEY=""
# 主模型；不可用时按 QWEN_FALLBACK_MODELS 顺序回退。
QWEN_PRIMARY_MODEL="qwen3-max"
QWEN_FALLBACK_MODELS="qwen-plus,qwen-turbo"

# ---- 首次启动演示账号（仅本地体验用，部署后请覆盖或忽略）----
DEFAULT_ADMIN_EMAIL="admin@retail-audit.local"
DEFAULT_ADMIN_PASSWORD="AdminDemo_2026"
DEFAULT_ADMIN_NAME="System Administrator"
DEFAULT_COMPANY_USER_EMAIL="company@retail-audit.local"
DEFAULT_COMPANY_USER_PASSWORD="CompanyDemo_2026"
DEFAULT_COMPANY_USER_NAME="Company Audit User"

# ---- 数据库 ----
# 默认 mysql；MySQL 不可用时自动回退到 data/ 目录下的本地 JSON 存储。
DATABASE_PROVIDER="mysql"
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="retail_audit_agent"
